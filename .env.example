# Ollama API endpoint (local or remote server)
OLLAMA_URL=http://localhost:11434/api/chat
# Optional: API key for authenticated endpoints
OLLAMA_API_KEY=
# LLM model name
OLLAMA_MODEL=qwen2.5:7b
# Whisper ASR model size (base, small, medium, large-v3)
WHISPER_MODEL=base
# Remote VLM model for scene description (uses same OLLAMA_URL)
# Leave empty to use local FastVLM
VISION_MODEL=
# Remote ASR server (faster-whisper-server)
# Leave empty to use local Whisper
ASR_URL=
ASR_MODEL=Systran/faster-whisper-large-v3
